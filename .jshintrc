{
  "esversion": 6,
  "browser": true,
  "jquery": true,
  "strict": false,
  "globalstrict": false,
  "undef": true,
  "unused": true,
  "curly": true,
  "eqeqeq": true,
  "immed": true,
  "latedef": true,
  "newcap": true,
  "noarg": true,
  "sub": true,
  "boss": true,
  "eqnull": true,
  "indent": 4,
  "quotmark": "single",
  "trailing": true,
  "maxlen": 120,
  "globals": {
    "webkitSpeechRecognition": false,
    "SpeechRecognition": false,
    "console": false,
    "sessionStorage": false,
    "localStorage": false,
    "window": false,
    "document": false,
    "alert": false,
    "confirm": false,
    "prompt": false,
    "setTimeout": false,
    "setInterval": false,
    "clearTimeout": false,
    "clearInterval": false,
    "encodeURIComponent": false,
    "decodeURIComponent": false,
    "parseInt": false,
    "parseFloat": false,
    "isNaN": false,
    "JSON": false,
    "$": false
  }
}