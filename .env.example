# Environment Configuration Template
# Copy this file to .env and update with your actual values

# SMS API Configuration
SMS_API_KEY=YOUR_SMS_API_KEY_HERE
SMS_SENDER_ID=MUSEUM
SMS_API_URL=https://smsapi.example.com/send

# Payment Configuration
UPI_ID=your-upi-id@bank
PAYMENT_CURRENCY=INR

# Application Configuration
APP_NAME=AI Ticket Booking Chatbot
APP_VERSION=1.0.0
APP_ENV=development

# Security Configuration
ENABLE_RATE_LIMITING=false
MAX_OTP_REQUESTS_PER_HOUR=3
SESSION_TIMEOUT=3600

# Feature Flags
ENABLE_VOICE_RECOGNITION=true
ENABLE_MULTILINGUAL=true
ENABLE_PAYMENT_INTEGRATION=true
ENABLE_ANALYTICS=false

# Debug Configuration
DEBUG_MODE=true
LOG_LEVEL=info

# Contact Information
ADMIN_EMAIL=admin@example.com
SUPPORT_EMAIL=support@example.com
SECURITY_EMAIL=security@example.com

# Social Media & Links
GITHUB_URL=https://github.com/ayushh9999/Ticket-Booking-Chatbot
DOCUMENTATION_URL=https://github.com/ayushh9999/Ticket-Booking-Chatbot/blob/main/docs/API.md
DEMO_URL=https://your-demo-site.com

# Notes:
# - Never commit .env files to version control
# - Keep this template updated with new configuration options
# - Use strong, unique values for production environments
# - Regularly rotate API keys and sensitive credentials